# Copy to .env and fill in. NEVER commit .env.
# Per-wallet keys. Name must match [[wallets]].name in config.toml (uppercased).
# No cookies needed: history, rebates, and fees all read via the operator key.

CANTEX_W1_OPERATOR_KEY=<operator Ed25519 private key hex>
CANTEX_W1_TRADING_KEY=<intent secp256k1 private key hex>

CANTEX_W2_OPERATOR_KEY=<operator Ed25519 private key hex>
CANTEX_W2_TRADING_KEY=<intent secp256k1 private key hex>

# Telegram logging
TELEGRAM_BOT_TOKEN=<bot token from @BotFather>
TELEGRAM_CHAT_ID=<your chat id>
